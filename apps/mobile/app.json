{
  "expo": {
    "name": "Controle Gestao Financeira",
    "slug": "controle-gestao-financeira-mobile",
    "scheme": "controle-gestao-financeira",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#020617"
    },
    "ios": {
      "bundleIdentifier": "com.matheusmeigre.controlegestaofinanceira",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.matheusmeigre.controlegestaofinanceira",
      "versionCode": 1,
      "usesCleartextTraffic": false
    },
    "extra": {
      "releaseChannel": "development",
      "router": {},
      "eas": {
        "projectId": "aeb79882-1c63-41af-beec-04862beced7e"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "owner": "uaimeigre",
    "updates": {
      "url": "https://u.expo.dev/aeb79882-1c63-41af-beec-04862beced7e"
    }
  }
}
