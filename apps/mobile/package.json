{
  "name": "@controle/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Fundação do app mobile consumindo o api-client tipado da API v1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "export": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/query-async-storage-persister": "^5.90.7",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-persist-client": "^5.90.7",
    "@clerk/clerk-expo": "^2.19.5",
    "@controle/api-client": "file:../../packages/api-client",
    "@controle/contracts": "file:../../packages/contracts",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~14.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.3",
    "eslint-config-expo": "^9.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
