{
  "name": "@controle/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Fundação do app mobile consumindo o api-client tipado da API v1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "export": "expo export --platform all --output-dir dist",
    "eas:configure": "npx --yes eas-cli@latest init",
    "eas:preview": "npx --yes eas-cli@latest build --platform all --profile preview",
    "eas:production": "npx --yes eas-cli@latest build --platform all --profile production"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.5",
    "@controle/api-client": "file:../../packages/api-client",
    "@controle/contracts": "file:../../packages/contracts",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/query-async-storage-persister": "^5.90.7",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-persist-client": "^5.90.7",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.39.3",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  }
}
