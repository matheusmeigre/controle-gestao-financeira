{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "preview"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_RELEASE_CHANNEL": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "mobile-release@example.com",
        "ascAppId": "0000000000"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
