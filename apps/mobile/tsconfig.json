{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "vitest/globals"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@api-client": [
        "../../packages/api-client/src/index.ts"
      ],
      "@api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@contracts/*": [
        "../../packages/contracts/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "expo-env.d.ts",
    "vitest.config.ts"
  ]
}
